# Copy to .env (which stays out of git) and fill in. See "Google Drive and OneDrive" in the README.
# These are the public IDs of the registered apps (not passwords); empty disables the option.
GOOGLE_CLIENT_ID=
ONEDRIVE_CLIENT_ID=

# start.sh only: 0.0.0.0 serves your network/the internet (default 127.0.0.1 = this computer only)
# HOST=0.0.0.0

# Docker: host port and address for the site (defaults 8080 and 127.0.0.1 = this machine only)
# APP_PORT=8080
# APP_BIND=127.0.0.1
